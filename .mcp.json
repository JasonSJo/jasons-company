{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--browser", "chrome",
        "--executable-path", "/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--viewport-size", "1280,900",
        "--output-dir", "/tmp/playwright-mcp"
      ]
    }
  }
}
